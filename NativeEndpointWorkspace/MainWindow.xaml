<Window x:Class="NativeEndpointWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Native Endpoint Workspace"
        Width="1500" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#171B21">
    <Window.Resources>
        <Style x:Key="ToolbarIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2A3039" BorderBrush="#46515F" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolbarIconButton}" Content="#" Click="Identify_Click" ToolTip="Identify Cells"/>
                    <Button x:Name="GroupVisibilityButton" Style="{StaticResource ToolbarIconButton}" Content="▁" Click="GroupVisibilityButton_Click" ToolTip="Minimize all bound endpoints"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="↺" Click="ResetTiling_Click" ToolTip="Reset Cell layout"/>
                    <Separator Width="8" Opacity="0"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="💾" Click="SaveLayout_Click" ToolTip="Save Workspace layout (Ctrl+S)"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="📂" Click="LoadLayout_Click" ToolTip="Load Workspace layout (Ctrl+O)"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolbarIconButton}" Content="⚙" Click="SettingsButton_Click" ToolTip="Workspace settings">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Shortcut Settings..." Click="ShortcutSettings_Click"/>
                                <Separator/>
                                <MenuItem Header="Advanced: Resync Endpoints" Click="ResyncEndpoints_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Separator Width="12" Opacity="0"/>
                    <TextBlock Text="Cells" Foreground="#DCE3EC" VerticalAlignment="Center" Margin="2,0,5,0"/>
                    <ComboBox x:Name="CellCountComboBox" Width="58" Margin="2" VerticalContentAlignment="Center"
                              SelectionChanged="CellCountComboBox_SelectionChanged"/>
                </StackPanel>
                <TextBlock Text="Adaptive tiled native endpoints • interactive throttled layout • no embedding" Foreground="#AAB4C3"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,6,0"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#232933" BorderBrush="#46515F" BorderThickness="0,1,0,0" Padding="8,5">
            <TextBlock x:Name="StatusText" Foreground="#C9D2DE" Text="Initializing..." TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid x:Name="WorkspaceGrid" Background="#171B21" ClipToBounds="True" Margin="6"/>
    </DockPanel>
</Window>
