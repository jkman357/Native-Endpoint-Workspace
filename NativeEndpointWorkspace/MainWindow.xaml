<Window x:Class="NativeEndpointWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Native Endpoint Workspace"
        Width="1500" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#171B21">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2A3039" BorderBrush="#46515F" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Identify" Margin="2" Padding="12,5" Click="Identify_Click"/>
                    <Button Content="Minimize Group" Margin="2" Padding="12,5" Click="MinimizeGroup_Click"/>
                    <Button Content="Restore Group" Margin="2" Padding="12,5" Click="RestoreGroup_Click"/>
                    <Separator Width="12" Opacity="0"/>
                    <Button Content="Reset Tiling" Margin="2" Padding="12,5" Click="ResetTiling_Click"/>
                    <Button Content="Resync Endpoints" Margin="2" Padding="12,5" Click="ResyncEndpoints_Click" ToolTip="Reapply current Cell geometry and Z-order to all bound endpoints without rebinding or restarting apps."/>
                    <Button Content="Save Layout" Margin="2" Padding="12,5" Click="SaveLayout_Click"/>
                    <Button Content="Load Layout" Margin="2" Padding="12,5" Click="LoadLayout_Click"/>
                    <Button Content="Shortcut Settings" Margin="2" Padding="12,5" Click="ShortcutSettings_Click"/>
                    <Separator Width="12" Opacity="0"/>
                    <TextBlock Text="Cells" Foreground="#DCE3EC" VerticalAlignment="Center" Margin="2,0,5,0"/>
                    <ComboBox x:Name="CellCountComboBox" Width="58" Margin="2" VerticalContentAlignment="Center"
                              SelectionChanged="CellCountComboBox_SelectionChanged"/>
                </StackPanel>
                <TextBlock Text="Adaptive tiled native endpoints • review-hardened adaptive layout lock • no embedding" Foreground="#AAB4C3"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,6,0"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#232933" BorderBrush="#46515F" BorderThickness="0,1,0,0" Padding="8,5">
            <TextBlock x:Name="StatusText" Foreground="#C9D2DE" Text="Initializing..." TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid x:Name="WorkspaceGrid" Background="#171B21" ClipToBounds="True" Margin="6"/>
    </DockPanel>
</Window>
